
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic authentication check
    function isAuthenticated() {
      return request.auth != null;
    }

    // Employees and their nested attendance logs
    match /employees/{employeeId} {
      allow read, write: if isAuthenticated();
      
      match /attendance/{date} {
        allow read, write: if isAuthenticated();
      }
    }

    // Direct access to daily attendance records
    match /attendance/{date}/records/{employeeId} {
      allow read, write: if isAuthenticated();
    }

    // Supplies and items registry
    match /items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // Inventory movement logs (Stock In / Stock Out)
    // Using a recursive wildcard to robustly allow collection listing and document access
    // Updated: 2024-05-20 - Explicit recursive match for stockAdjustments
    match /stockAdjustments/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }
    
    // Fallback for root collection listing if needed
    match /stockAdjustments {
      allow list: if isAuthenticated();
    }
  }
}
