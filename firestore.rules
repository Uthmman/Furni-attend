rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic authentication check
    function isAuthenticated() {
      return request.auth != null;
    }

    // Employees and their nested attendance logs
    match /employees/{employeeId} {
      allow read, write: if isAuthenticated();
      
      match /attendance/{date} {
        allow read, write: if isAuthenticated();
      }
    }

    // Direct access to daily attendance records
    match /attendance/{date}/records/{employeeId} {
      allow read, write: if isAuthenticated();
    }

    // Supplies and items registry
    match /items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // Inventory movement logs (Stock In / Stock Out)
    match /stockAdjustments/{adjustmentId} {
      // Explicitly allow both individual read (get) and collection queries (list)
      allow read, write: if isAuthenticated();
    }
  }
}