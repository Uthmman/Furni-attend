
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic authentication check
    function isAuthenticated() {
      return request.auth != null;
    }

    // Employees and their nested attendance logs
    match /employees/{employeeId} {
      allow read, write: if isAuthenticated();
      
      match /attendance/{date} {
        allow read, write: if isAuthenticated();
      }
    }

    // Direct access to daily attendance records
    match /attendance/{date}/records/{employeeId} {
      allow read, write: if isAuthenticated();
    }

    // Supplies and items registry
    match /items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // Inventory movement logs (Stock In / Stock Out)
    // Refactored to standard read/write permissions to ensure list compatibility
    match /stockAdjustments/{adjustmentId} {
      allow read, write: if isAuthenticated();
    }

    // Explicitly allow listing the stockAdjustments collection
    // This provides a fallback to ensure the "list" method is explicitly allowed
    match /stockAdjustments {
      allow list: if isAuthenticated();
    }
  }
}
