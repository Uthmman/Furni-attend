rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic authentication check
    function isAuthenticated() {
      return request.auth != null;
    }

    // Employees and their nested attendance logs
    match /employees/{employeeId} {
      allow read, write: if isAuthenticated();
      
      match /attendance/{date} {
        allow read, write: if isAuthenticated();
      }
    }

    // Direct access to daily attendance records
    match /attendance/{date}/records/{employeeId} {
      allow read, write: if isAuthenticated();
    }

    // Supplies registry and movement logs
    // Robust access control for Store Management
    match /items/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /stockAdjustments/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // Deployment hash: 1759405622000
    // This comment ensures the rules are re-propagated to resolve any stuck permission states.
  }
}