rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic authentication check
    function isAuthenticated() {
      return request.auth != null;
    }

    // Employees and their nested attendance logs
    match /employees/{employeeId} {
      allow read, write: if isAuthenticated();
      
      match /attendance/{date} {
        allow read, write: if isAuthenticated();
      }
    }

    // Direct access to daily attendance records (top-level collection)
    match /attendance/{date}/records/{employeeId} {
      allow read, write: if isAuthenticated();
    }

    // Supplies registry management
    match /items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // Inventory movement and financial tracking audit log
    // Explicitly allowing list and read operations for authenticated users
    match /stockAdjustments/{adjustmentId} {
      allow read, write: if isAuthenticated();
    }

    // Final catch-all for collection-level queries on stockAdjustments
    match /stockAdjustments {
      allow list: if isAuthenticated();
    }
  }
}