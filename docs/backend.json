{
  "entities": {
    "Employee": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Employee",
      "type": "object",
      "description": "Represents an employee of the company.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "position": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "paymentMethod": { "type": "string", "enum": ["Weekly", "Monthly"] },
        "accountNumber": { "type": "string" },
        "dailyRate": { "type": "number" },
        "monthlyRate": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "attendanceStartDate": { "type": "string", "format": "date" }
      },
      "required": ["name", "phone", "paymentMethod", "accountNumber", "attendanceStartDate"]
    },
    "Attendance": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Attendance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "morningEntry": { "type": "string" },
        "afternoonEntry": { "type": "string" },
        "morningStatus": { "type": "string", "enum": ["Present", "Absent", "Late", "Permission"] },
        "afternoonStatus": { "type": "string", "enum": ["Present", "Absent", "Late", "Permission"] },
        "overtimeHours": { "type": "number" }
      },
      "required": ["employeeId", "date", "morningStatus", "afternoonStatus"]
    },
    "Item": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "unitOfMeasurement": { "type": "string" },
        "stockLevel": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "currentPrice": { "type": "number" }
      },
      "required": ["name", "category", "unitOfMeasurement", "stockLevel"]
    },
    "StockAdjustment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StockAdjustment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "adjustmentDate": { "type": "string", "format": "date-time" },
        "adjustmentQuantity": { "type": "number" },
        "type": { "type": "string", "enum": ["In", "Out"] },
        "reason": { "type": "string" },
        "unitPrice": { "type": "number" },
        "totalPrice": { "type": "number" },
        "supplier": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Unpaid"] }
      },
      "required": ["itemId", "adjustmentDate", "adjustmentQuantity", "type", "reason"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/backend/entities/Employee" },
      "description": "Employee directory."
    },
    "/employees/{employeeId}/attendance/{date}": {
      "schema": { "$ref": "#/backend/entities/Attendance" },
      "description": "Personal attendance logs."
    },
    "/attendance/{date}/records/{employeeId}": {
      "schema": { "$ref": "#/backend/entities/Attendance" },
      "description": "Daily workshop attendance logs."
    },
    "/items/{itemId}": {
      "schema": { "$ref": "#/backend/entities/Item" },
      "description": "Supplies registry."
    },
    "/stockAdjustments/{adjustmentId}": {
      "schema": { "$ref": "#/backend/entities/StockAdjustment" },
      "description": "Inventory movement and cost history audit log."
    }
  }
}